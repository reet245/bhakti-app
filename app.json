{
  "expo": {
    "name": "Bhakti",
    "slug": "bhakti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hreetp.bhaktiapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Bhakti",
      "shortName": "Bhakti",
      "lang": "en",
      "display": "standalone",
      "startUrl": ".",
      "scope": ".",
      "themeColor": "#f4c45f",
      "backgroundColor": "#fff6e2",
      "description": "Daily Panchang, horoscope, puja, mantras, and bhakti guidance."
    },
    "owner": "hreetp",
    "extra": {
      "eas": {
        "projectId": "96b3fd78-f2e0-4df0-ba4e-9cc85865417a"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bhakti uses your location only when you choose Detect Location for Panchang or a birthplace."
        }
      ]
    ]
  }
}
